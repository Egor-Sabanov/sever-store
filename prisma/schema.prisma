generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  NEW
  CONFIRMED
  PACKING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum DeliveryMethod {
  COURIER
  PICKUP
}

model Product {
  id          String      @id
  slug        String      @unique
  name        String
  category    String
  price       Int
  oldPrice    Int?
  image       String
  imageAlt    String
  label       String?
  color       String
  description String
  materials   String
  sizes       String[]
  stock       Int         @default(0)
  featured    Boolean     @default(false)
  active      Boolean     @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([active, featured])
  @@index([category, active])
}

model Order {
  id             String         @id @default(cuid())
  orderNumber    String         @unique
  customerName   String
  customerPhone  String
  customerEmail  String?
  city           String
  address        String
  deliveryMethod DeliveryMethod
  comment        String?
  subtotal       Int
  deliveryPrice  Int
  total          Int
  consentAt      DateTime
  status         OrderStatus    @default(NEW)
  items          OrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  productSlug String
  size        String
  quantity    Int
  unitPrice   Int
  lineTotal   Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}
