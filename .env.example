# Copy to .env and replace placeholders with private connection details.
# Use the pooled connection for the running app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sever_store?schema=public"

# Use a direct connection for migrations and seeds.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/sever_store?schema=public"

# Public address used for canonical metadata after deployment.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Generate a fresh random secret and a password hash locally before enabling /admin.
AUTH_SECRET=""
ADMIN_PASSWORD_HASH=""
